# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ipynb_checkpoints/

# Secrets
.env
kaggle.json

# Data: raw Kaggle files and the built warehouse are never committed
data/raw/*
!data/raw/.gitkeep
data/fixture/
data/warehouse/*
!data/warehouse/.gitkeep
# Simulated dates are regenerated with `hcdw synth-dates`
data/synthetic/*
!data/synthetic/.gitkeep

# Models (commit only metrics / feature lists, not binaries)
models/*.pkl
models/*.joblib
models/*.parquet

# LaTeX build output
reports/*/*.aux
reports/*/*.log
reports/*/*.out
reports/*/*.toc
reports/*/*.synctex.gz
reports/*/*.fdb_*mk
reports/*/*.fls

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Developer
graphify-out/
.agents/