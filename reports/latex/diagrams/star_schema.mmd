erDiagram
    dim_risk_grade {
        string grade PK "A-E"
        string decision
        double max_credit_to_income
    }

    dim_contract {
        int contract_key PK
        string contract_type
    }

    dim_credit_history {
        int credit_history_key PK
        string credit_history_status
        string max_dpd_bucket
    }

    dim_region {
        int region_key PK
        int region_rating_client
    }

    dim_customer {
        int customer_key PK
        string age_bucket
        string income_type
    }

    dim_time {
        int date_key PK
        date full_date
        string year_month
    }

    dim_bureau_category {
        int bureau_category_key PK
        string credit_active
        string credit_type
    }

    fact_loan_application {
        bigint application_id PK
        int customer_key FK
        int credit_history_key FK
        int contract_key FK
        int region_key FK
        int application_date_key FK
        int outcome_date_key FK "NULL: hồ sơ mới"
        int target
        double amt_credit
        double debt_to_income
    }

    fact_bureau_credit {
        bigint bureau_credit_id PK
        int customer_key FK
        int bureau_category_key FK
        int open_date_key FK
        int close_date_key FK
        double amt_credit_sum
        double amt_credit_sum_debt
    }

    fact_risk_assessment {
        bigint application_id PK "FK"
        string score_grade FK
        string rule_grade FK
        string final_grade FK
        double pd
        string decision
        double recommended_credit
    }

    dim_rule {
        string rule_code PK
        string rule_group
    }

    fact_rule_hit {
        bigint application_id FK
        string rule_code FK
        string grade FK
        double rate
    }

    dim_contract ||--o{ fact_loan_application : "contract_key"
    dim_credit_history ||--o{ fact_loan_application : "credit_history_key"
    dim_region ||--o{ fact_loan_application : "region_key"
    dim_customer ||--o{ fact_loan_application : "customer_key"
    dim_time ||--o{ fact_loan_application : "application_date_key, outcome_date_key"

    dim_customer ||--o{ fact_bureau_credit : "customer_key"
    dim_time ||--o{ fact_bureau_credit : "open_date_key, close_date_key"
    dim_bureau_category ||--o{ fact_bureau_credit : "bureau_category_key"

    dim_risk_grade ||--o{ fact_risk_assessment : "score, rule, final grade"
    fact_loan_application ||--o| fact_risk_assessment : "application_id"
    dim_risk_grade ||--o{ fact_rule_hit : "grade"
    fact_risk_assessment ||--o{ fact_rule_hit : "application_id"
    dim_rule ||--o{ fact_rule_hit : "rule_code"
